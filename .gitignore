# ==============================================================================
# .gitignore - Proteção de Credenciais, Estados do Terraform e Ambientes Locais
# ==============================================================================

# Variáveis de ambiente e segredos (LGPD & Segurança Fase 2)
.env
.env.*
.streamlit/secrets.toml

# Terraform (IaC)
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!terraform.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Python / ETL
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.pytest_cache/
*.egg-info/

# Bancos locais temporários e logs (mantém o Data Warehouse oficial dw_violencia_interseccional.db)
*.db
!data/processed/dw_violencia_interseccional.db
*.sqlite3
*.log

# Arquivos de sistema, IDE, documentos Word locais e planilhas brutas contendo dados sensíveis (LGPD)
.DS_Store
Thumbs.db
.vscode/
.idea/
~$*.xlsx
*.xlsx
*.docx
